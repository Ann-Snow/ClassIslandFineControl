// =====================================================================
// ClassIsland 精细化管理插件 —— 集控权限配置文件（完整模板 v1.1.8）
// ---------------------------------------------------------------------
// 覆盖全部设置页与页内设置项（取自 ClassIsland 2.1.0.1 官方源码与实机截图）。
// 全部为 Operable，可按需把任意项改为 Disabled（置灰）/ Hidden（隐藏）。
// 支持 // 与 /* */ 注释（插件解析时自动忽略）。
// 字段说明：
//   key             —— 控件匹配键（页面上可见的标题文本）
//   matchMode       —— HeaderText（默认，标题匹配）/ Name / AutomationId / Wildcard
//   permission      —— Operable（可操作）/ Disabled（置灰）/ Hidden（隐藏）
//   settingsProperty—— 可选值级锁定属性（Settings 模型真实属性）；null=仅 UI 拦截
//   remark          —— 备注（可选）
// 大页 permission 继承：Disabled/Hidden → 组内所有小页整体失效；Operable → 小页独立控制。
// =====================================================================
{
  "schemaVersion": 1,
  "defaultPermission": "Operable",

  // 自保护总开关（默认 false）：开启后插件置灰本插件详情工具菜单、
  // 隐藏插件页“刷新”、锁定自身“已启用/移除”，并拦截禁用/移除标记文件。
  "selfProtection": false,

  // 锁定插件：这些插件的启用开关在“插件”页中会被强制置灰，学生无法取消启用。
  // 值为插件 manifest 中的 id（本插件为 cn.finecontrol.permission）。
  // 建议至少锁住本插件，防止学生关闭管控导致管理失效。
  "lockedPlugins": ["cn.finecontrol.permission"],

  // ===================== 大页：通用 =====================
